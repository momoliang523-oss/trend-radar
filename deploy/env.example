# trend-radar 服务器环境变量(复制为 deploy/env 并填写真实值,chmod 600,绝不进版本库)
# 注:不填的项用默认值;密钥三项(支付宝/发现报告/LLM 网关)缺一,对应功能自动降级

# 管理员邮箱(逗号分隔多个;用这些邮箱注册登录即管理员)
TREND_RADAR_ADMIN_EMAILS=you@example.com

# 发现报告研报 key(选品页研报板块;不配则整块隐藏)
# FXBAOGAO_API_KEY=

# 支付宝当面付(三项齐全才启用真支付;缺任一 → 自动 mock)
# ALIPAY_APP_ID=
# ALIPAY_PRIVATE_KEY=   # 应用私钥 PEM,多行用 $'...\n...' 或双引号内 \n
# ALIPAY_PUBLIC_KEY=
# ALIPAY_NOTIFY_URL=https://你的域名/api/pay/notify/alipay   # 有域名后再填,不填也能到账(客户端轮询)

# LLM 网关(LiteLLM):指向服务器本机网关
MAGPIE_BASE_URL=http://127.0.0.1:8740
MAGPIE_API_KEY=
LLM_MODEL_FREE=deepseek-flash
LLM_MODEL_MID=deepseek-v4-pro
LLM_MODEL_HIGH=typesafe/jev-router

# 监听:保持 127.0.0.1,由 Caddy 反代对外;直接对外才改 0.0.0.0
# HOST=127.0.0.1
# PORT=8124

# 数据目录(默认 app 内 data/,建议指向 /opt/trend-radar/data)
TREND_RADAR_DATA_DIR=/opt/trend-radar/data
